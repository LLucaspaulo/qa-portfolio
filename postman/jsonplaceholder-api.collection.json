{
  "info": {
    "name": "JSONPlaceholder - Smoke API QA",
    "description": "Exemplos de testes de API para portfólio QA (Lucas Paulo). API pública: https://jsonplaceholder.typicode.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "GET /posts/1 - status 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body contém userId', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('userId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /users - lista não vazia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Array com usuários', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ]
}
